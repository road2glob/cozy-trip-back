# Copy to .dev.vars for local use. .dev.vars is gitignored; never commit it.
# Key names and placeholders only.

# stub = in-process deterministic fake; binding = Service Binding TASKPASS; https = fallback (needs TASKPASS_BASE_URL)
TASKPASS_TRANSPORT=stub

# Public origin of the return pages, no path
PUBLIC_RETURN_ORIGIN=http://localhost:8788

# Second credential sent with every call to the payment & verification service. Deployed value is a secret set by the PM.
TASKPASS_PRODUCT_TOKEN=replace-me

# Only used when TASKPASS_TRANSPORT=https
# TASKPASS_BASE_URL=https://example.invalid
